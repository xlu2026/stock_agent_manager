# 忽略运行时产物与本地凭据
.env
.env.local
*.pyc
__pycache__/
*.tmp
*.bak

# 本地草稿/临时产物
output/rejected/
.probe/
.tmp/

# 运行时记录：会话证据与模拟盘台账，不进公开仓库
output/evidence/
output/broker/

# 仓库根 articles/ 是误生成的副本；成文稿只在写作工作区
/articles/
output.log
output/data_jobs/
output/reports/publish_cards/

# Agent 2 的机器相关配置（含本地 Python 路径），只保留示例
config/agent2.json

# SmartX 账号/目录配置，只保留示例
config/smartx.json

# QMT 账户/目录配置，只保留示例
config/qmt.json

# QMT 生成物含账户号/本地路径，不进公开仓库
output/qmt/

# 本地回测/paper 运行产物（可由命令重建；公开记录看 experiments/ 与 reports/*.md）
output/paper/
output/validation/
output/walk_forward/
output/cost_sensitivity/
output/reports/strategy_grid/
output/reports/strategy_grid_2024/
output/reports/strategy_robustness/
output/reports/strategy_weights/
output/reports/sweeps/
output/reports/zhihu_articles.html
output/reports/zhihu_articles_files/

# 最新快照指针（运行时产物）
output/data/

# 实验持仓的个股代码只留在本地
experiments/.private/

# 汇报 JSON 可随时用 `python scripts\acceptance.py` 重新生成，
# 但验收结论要留在仓库里，作为可复查的证据。
output/reports/*.json
!output/reports/acceptance.json

# experiments/ 不忽略：实验记录本身是"公开日志"的一部分，
# 每条记录都带 spec、数据指纹与 nav_hash，删掉就等于毁掉可复现性。
